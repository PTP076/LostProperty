@model FindIt.Models.Item

@{
    ViewData["Title"] = "Claim Item";
}

<h2>Claim Verification</h2>
<h4>Item: @Model.Name</h4>
<hr />

<div class="row">
    <div class="col-md-6">
        <p><strong>Description:</strong> @Model.Description</p>
        <p><strong>Location Found:</strong> @Model.LocationFound</p>
        
        <form asp-action="Claim">
            <input type="hidden" asp-for="Id" />
            <div class="form-group mb-3">
                <label class="control-label">Security Verification Question:</label>
                <p class="text-info"><strong>@Model.SecretQuestion</strong></p>
                <input name="answer" class="form-control" placeholder="Type your answer to prove ownership..." required />
            </div>
            <div class="form-group">
                <input type="submit" value="Submit Claim" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>